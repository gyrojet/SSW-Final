@using ProjectDbStarter.Models
@model IEnumerable<Team>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Team Id</th>
            <th>Team Name</th>
            <th>Division Id</th>
            <th>Registration Paid?</th>
            <th>Payment Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TeamId</td>
                <td>@item.TeamName</td>
                <td>@item.DivisionId</td>
                <td>@(item.RegistrationPaid ? "Yes" : "No")</td>
                <td>@item.PaymentDate</td>
            </tr>
        }
    </tbody>
</table>
